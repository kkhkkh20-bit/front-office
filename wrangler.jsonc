// The dashboard's old `cp index.html` command is overridden here before upload.
// Website models load as separate versioned assets; downloadable index.html stays standalone.
{
  "name": "fronttime",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "npm --prefix tools ci --no-audit --no-fund && node tools/build-site.cjs"
  },
  "assets": { "directory": "./site" },
  // PR 브랜치 미리보기(`npx wrangler preview`)는 이 블록이 있어야 실행된다. 비어 있어도 된다.
  "previews": {}
}
