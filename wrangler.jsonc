// The dashboard's old `cp index.html` command is overridden here before upload.
// Website models load as separate versioned assets; downloadable index.html stays standalone.
{
  "name": "fronttime",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "npm --prefix tools ci --no-audit --no-fund && node tools/build-site.cjs"
  },
  // 기기 옮기기 API(/api/transfer)만 Worker가 먼저 받고, 나머지는 ./site 정적 파일을 그대로 낸다.
  "main": "worker/index.js",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // 기기 옮기기 저장소(Workers KV). 운영자가 대시보드에서 만든 namespace id를 넣고 주석을 푼다: docs/save-transfer.md
  // fronttime-save-transfer (11-16 운영자 생성)
  "kv_namespaces": [{ "binding": "SAVE_KV", "id": "a7589ac1fd754b918c80a34ebbcef77b" }],
  // 서버 v1(/api/v1, docs/server-setup.md): D1 데이터베이스. 없으면 v1만 503 not_configured이고 나머지는 그대로 돈다(배포에 필요 없음).
  // 대시보드에서 바인딩을 추가했다면 그대로 두어도 된다. 설정 파일로 관리하려면 아래 주석을 풀고 database_id에 대시보드의 ID를 넣는다.
  // 주의: 대시보드로만 추가한 바인딩은 다음 자동 배포(Workers Builds) 때 이 파일 기준으로 사라질 수 있다 → 이 블록을 푸는 것을 권장.
  "d1_databases": [{ "binding": "DB", "database_name": "fronttime-db", "database_id": "4a7684f1-5f5b-412d-8849-f6130a8f9e39", "migrations_dir": "migrations" }],
  // 선택: 매일 시즌 교체 확인(Cron Trigger, 무료). 없어도 요청이 들어올 때 바꾼다.
  // "triggers": { "crons": ["7 15 * * *"] },
  // 선택: 요청 수 제한(Workers Rate Limiting). 없으면 서버 메모리에서 대략 센다.
  // "ratelimits": [{ "name": "V1_RL", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  // PR 브랜치 미리보기(`npx wrangler preview`)는 이 블록이 있어야 실행된다. 비어 있어도 된다.
  "previews": {}
}
